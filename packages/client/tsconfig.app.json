{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@sky/shared": ["../shared/src/index.ts"],
      "@platform/engine": ["../engine/src/index.ts"],
      "@platform/protocol": ["../protocol/src/index.ts"]
    }
  },
  "include": ["src", "../shared/src", "../engine/src", "../protocol/src"],
  "exclude": [
    "../shared/src/**/*.test.ts",
    "../engine/src/**/*.test.ts",
    "../engine/src/testing.ts"
  ]
}
